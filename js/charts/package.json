{
  "name": "patternfly-yew-charts-bundle",
  "version": "0.0.0",
  "private": true,
  "description": "Builds the ES module embedding React and the Victory based PatternFly charts, used by the `charts` feature of patternfly-yew",
  "scripts": {
    "build": "esbuild index.js --bundle --minify --format=esm --target=es2020 --legal-comments=eof --define:process.env.NODE_ENV='\"production\"' --outfile=../../src/charts/js/patternfly-charts.js"
  },
  "devDependencies": {
    "@patternfly/react-charts": "8.7.0",
    "esbuild": "0.25.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "victory-area": "37.3.6",
    "victory-axis": "37.3.6",
    "victory-bar": "37.3.6",
    "victory-box-plot": "37.3.6",
    "victory-chart": "37.3.6",
    "victory-core": "37.3.6",
    "victory-create-container": "37.3.6",
    "victory-cursor-container": "37.3.6",
    "victory-group": "37.3.6",
    "victory-legend": "37.3.6",
    "victory-line": "37.3.6",
    "victory-pie": "37.3.6",
    "victory-scatter": "37.3.6",
    "victory-stack": "37.3.6",
    "victory-tooltip": "37.3.6",
    "victory-voronoi-container": "37.3.6",
    "victory-zoom-container": "37.3.6"
  }
}
